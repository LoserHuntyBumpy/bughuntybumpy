# .env.example -> kopieren nach .env, Werte setzen. .env NICHT committen.
PG_PASSWORD=change-me-strong
MINIO_ACCESS_KEY=bhbminio
MINIO_SECRET_KEY=change-me-strong
GITHUB_APP_ID=000000
# Reporter-Step-Timeout im Runner (Sekunden)
STEP_TIMEOUT_SEC=120
# Max Repro-Schritte pro Job (Runner-Cap, DoS-Schutz)
MAX_STEPS=50
# Broker-Timeboxen
REALTIME_TIMEBOX_SEC=600
OVERNIGHT_TIMEBOX_SEC=14400
# GID der Docker-Socket-Gruppe (Broker-Socket-Zugriff non-root, F-002).
# Linux: GID der docker-Gruppe (z. B. 999). Docker Desktop: 0.
DOCKER_GID=999
# Traefik-Dashboard BasicAuth (htpasswd-Hash, $ als $$ escapen).
# Leer -> traefik startet NICHT. deploy/01_bootstrap.sh generiert Wert.
TRAEFIK_DASHBOARD_AUTH=
